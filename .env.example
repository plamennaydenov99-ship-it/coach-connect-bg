# Copy to .env.local for local development. Only VITE_* values reach the browser,
# so never put a secret (service-role key, Resend key, payment key) in this file.

# Supabase project (public by design)
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Optional audience measurement, loaded only after the visitor consents (src/lib/analytics.ts).
# Leave empty to keep the site free of analytics. If you set them, also add the tool's host to
# the Content-Security-Policy in public/_headers and list the tool on the privacy and cookie pages.
VITE_ANALYTICS_SCRIPT_URL=
VITE_ANALYTICS_SITE_ID=
VITE_ANALYTICS_SITE_ATTR=data-website-id

# Server-side secrets: set these in the Supabase / Lovable project settings, never here.
# RESEND_API_KEY, LOVABLE_API_KEY, SUPABASE_SERVICE_ROLE_KEY, ADMIN_NOTIFICATION_EMAIL
