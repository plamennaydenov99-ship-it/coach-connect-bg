# Security headers for every page. This file format is read by Netlify and Cloudflare Pages.
# Other hosts (Vercel, Lovable hosting, nginx) need the same headers set in their own config:
# see docs/launch-hosting.md.
#
# Content-Security-Policy is built from the data map in LAUNCH_AUDIT.md:
# - scripts, styles and fonts come only from this site (fonts are self-hosted)
# - the app talks only to its Supabase project (HTTPS and websockets)
# - images may come from any HTTPS host (event and club images, Supabase storage)
# If you add analytics, add its script and collection host to script-src and connect-src.
#
# HSTS has no "preload" on purpose: preload is hard to undo and needs the owner's decision.

/*
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' https://xllvzdocxsqawwaqfbxk.supabase.co wss://xllvzdocxsqawwaqfbxk.supabase.co; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  X-Frame-Options: DENY

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
